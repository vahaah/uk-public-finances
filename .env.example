# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Snapshot store. Without this, the site reads fixtures/snapshots.
BLOB_READ_WRITE_TOKEN=

# Optional. Manual OBR workbook lives at manual/obr-public-finances.xlsx in that store.
# Upload: vercel blob put manual/obr-public-finances.xlsx ./public-finances-databank.xlsx --allow-overwrite

# IndexNow. The key is public (it is served at /{INDEXNOW_KEY}.txt).
INDEXNOW_KEY=
INDEXNOW_HOST=budget.vahaah.com

# Set to 1 in CI so publish-check also runs Playwright.
PUBLISH_CHECK_E2E=
